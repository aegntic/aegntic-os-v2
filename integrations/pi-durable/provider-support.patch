+test("Aegntic Codex catalog reopens sessions before availability is loaded and keeps the coding profile", async () => {
+  const t = await tempStore();
+  const authFile = join(t.root, "codex-fixture.json");
+  const previous = process.env.DPI_CODEX_AUTH_FILE;
+  // Synthetic auth metadata only: no model call or external credential is used.
+  const payload = Buffer.from(JSON.stringify({ exp: Math.floor(Date.now() / 1000) + 3600 })).toString("base64url");
+  await (await import("node:fs/promises")).writeFile(authFile, JSON.stringify({ tokens: { access_token: `fixture.${payload}.fixture` } }), { mode: 0o600 });
+  process.env.DPI_CODEX_AUTH_FILE = authFile;
+  const { Store: RuntimeStore } = await import("../src/store.js");
+  const options = { ...t.options, provider: "codex" as const };
+  let store = await RuntimeStore.open(options);
+  try {
+    const model = store.deviceInfo().defaultModel;
+    const session = await store.create({ name: "Codex restart fixture", cwd: t.work, model: { provider: "openai-codex", modelId: model } });
+    await store.close(); store = await RuntimeStore.open(options);
+    const main = await store.resolveAgent(session.id, "main");
+    await store.configure(main.row, main.c, { readOnly: false, toolProfile: "aegntic-coding" });
+    const offered = (await store.agentDetail(main.row, main.c)).tools.filter((tool) => tool.offered).map((tool) => tool.name).sort();
+    assert.deepEqual(offered, ["bash", "edit", "read", "write"]);
+    assert.deepEqual(await store.lookupSubmission(main.h, main.c, "not-admitted"), { submissionId: null });
+  } finally {
+    await store.close(); await t.cleanup();
+    if (previous === undefined) delete process.env.DPI_CODEX_AUTH_FILE; else process.env.DPI_CODEX_AUTH_FILE = previous;
+  }
+});
+
+test("Aegntic drafting removes every actual agent tool, survives restart and preserves coding configuration", async () => {
+  const t = await tempStore();
+  let store = await t.open();
+  try {
+    assert.equal(store.deviceInfo().aegnticDrafting, 1);
+    const session = await store.create({ name: "Tool-free drafting fixture", cwd: t.work, model: faux });
+    let main = await store.resolveAgent(session.id, "main");
+    assert.ok((await main.c.agent(ctx)).tools.length > 0);
+    await assert.rejects(() => store.configure(main.row, main.c, { toolProfile: "unknown-profile" }), /Unknown tool profile/);
+    await store.configure(main.row, main.c, { readOnly: false, toolProfile: "aegntic-drafting" });
+    assert.deepEqual((await main.c.agent(ctx)).tools, [], "runtime offers zero tools regardless of readOnly");
+    assert.ok((await store.agentDetail(main.row, main.c)).tools.every((tool) => !tool.offered));
+    await store.close(); store = await t.open();
+    main = await store.resolveAgent(session.id, "main");
+    assert.deepEqual((await main.c.agent(ctx)).tools, [], "durable config keeps zero tools after restart");
+    await store.configure(main.row, main.c, { readOnly: false, toolProfile: "aegntic-coding" });
+    assert.deepEqual((await main.c.agent(ctx)).tools.map((tool) => tool.name).sort(), ["bash", "edit", "read", "write"]);
+    await store.configure(main.row, main.c, { readOnly: true, toolProfile: "aegntic-drafting" });
+    assert.deepEqual((await main.c.agent(ctx)).tools, []);
+  } finally {
+    await store.close(); await t.cleanup();
+  }
+});
