{
  "name": "aegntic-build",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aegntic-db",
      "database_id": "52178e54-2dc7-4e03-83a0-186d72696b24"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "build.aegntic.ai",
      "custom_domain": true
    }
  ]
}
